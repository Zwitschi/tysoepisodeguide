{
  "config": {
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": ["br", "details", "summary"]
    },
    "MD041": false,
    "MD060": false
  },
  "globs": [
    "**/*.md",
    "!node_modules",
    "!.venv",
    "!.github/instructions/DONE.md"
  ]
}